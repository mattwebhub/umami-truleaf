{
  "name": "@umami/agent-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Project-configured MCP server for Umami's scoped agent analytics API.",
  "type": "module",
  "bin": {
    "umami-agent-mcp": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
